---
import '../styles/global.css';
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import { VORSCHAU, BASIS_URL, istGebaut } from '../lib/inhalte.mjs';
import { firma, telefonNbsp, ICON_TEL_HTML } from '../lib/fakten-html.mjs';
const { titel, beschreibung, url, noindex = false, jsonld = null, ogTyp = 'website', ogBild = '/og/standard.jpg', marker = 0, anrufleiste = true, hashUmleitung = false } = Astro.props;
const canonical = BASIS_URL + url;
const robots = VORSCHAU || noindex ? 'noindex, follow' : null;
const bewertenOk = istGebaut('/wohnung-bewerten/');
---
<!doctype html>
<html lang="de">
<head>
{hashUmleitung && <script is:inline>(function(){var m={verkaufen:"/wohnung-verkaufen/",ankauf:"/direktankauf/",person:"/ueber-mich/",kontakt:"/kontakt/",impressum:"/impressum/",datenschutz:"/datenschutz/"};var z=m[location.hash.slice(1)];if(z)location.replace(z);})();</script>}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{titel}</title>
<meta name="description" content={beschreibung}>
<link rel="canonical" href={canonical}>
{robots && <meta name="robots" content={robots}>}
<link rel="preload" href="/fonts/libre-franklin-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#16233D">
<meta property="og:type" content={ogTyp}>
<meta property="og:title" content={titel}>
<meta property="og:description" content={beschreibung}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={BASIS_URL + ogBild}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Rössler Immobilien, Linus Rössler: Eigentumswohnungen in Heimsheim, Leonberg, Ditzingen, Renningen und Pforzheim">
<meta property="og:locale" content="de_DE">
<meta property="og:site_name" content="Rössler Immobilien">
<meta name="twitter:card" content="summary_large_image">
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld).replace(/</g, '\\u003c')} />}
</head>
<body>
<a class="skiplink" href="#inhalt">Zum Inhalt springen</a>
{VORSCHAU && <p class="vorschau-banner">Vorschau, nicht veröffentlicht. Offene Marker auf dieser Seite: {marker}</p>}
<Kopf aktiv={url} />
<main id="inhalt" tabindex="-1">
<slot />
</main>
<Fuss />
{anrufleiste && (
  <aside class="anrufleiste" aria-label="Schnellkontakt">
    <a class="btn line" href={firma.telefonHref}><Fragment set:html={ICON_TEL_HTML} />Anrufen</a>
    {bewertenOk && <a class="btn" href="/wohnung-bewerten/">Wohnung einschätzen lassen</a>}
  </aside>
)}
<script src="../scripts/seite.js"></script>
</body>
</html>
